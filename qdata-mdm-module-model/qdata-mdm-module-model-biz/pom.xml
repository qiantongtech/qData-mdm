<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>qdata-mdm-module-model</artifactId>
        <groupId>tech.qiantong</groupId>
        <version>${qdata-mdm.version}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>qdata-mdm-module-model-biz</artifactId>

    <description>
        model模型模块
    </description>

    <dependencies>
        <!-- Core module configuration-->
        <dependency>
            <groupId>tech.qiantong</groupId>
            <artifactId>qdata-mdm-config</artifactId>
            <version>${qdata-mdm.version}</version>
        </dependency>

        <!-- system module websocket-->
        <dependency>
            <groupId>tech.qiantong</groupId>
            <artifactId>qdata-mdm-websocket</artifactId>
            <version>${qdata-mdm.version}</version>
        </dependency>

        <!-- system module qdata-mdm-security -->
        <dependency>
            <groupId>tech.qiantong</groupId>
            <artifactId>qdata-mdm-security</artifactId>
            <version>${qdata-mdm.version}</version>
        </dependency>

        <!-- system module mybatis -->
        <dependency>
            <groupId>tech.qiantong</groupId>
            <artifactId>qdata-mdm-mybatis</artifactId>
            <version>${qdata-mdm.version}</version>
        </dependency>

        <!-- system module redis -->
        <dependency>
            <groupId>tech.qiantong</groupId>
            <artifactId>qdata-mdm-redis</artifactId>
            <version>${qdata-mdm.version}</version>
        </dependency>

        <!-- system API module -->
        <dependency>
            <groupId>tech.qiantong</groupId>
            <artifactId>qdata-mdm-module-system-api</artifactId>
            <version>${qdata-mdm.version}</version>
        </dependency>

        <!-- Scheduled tasks-->
        <dependency>
            <groupId>tech.qiantong</groupId>
            <artifactId>qdata-mdm-quartz</artifactId>
        </dependency>

        <!-- Code generation-->
        <dependency>
            <groupId>tech.qiantong</groupId>
            <artifactId>qdata-mdm-generator</artifactId>
        </dependency>

        <!-- Common utilities-->
        <dependency>
            <groupId>tech.qiantong</groupId>
            <artifactId>qdata-mdm-common</artifactId>
        </dependency>

        <!-- File upload-->
        <dependency>
            <groupId>tech.qiantong</groupId>
            <artifactId>qdata-mdm-file</artifactId>
            <version>${qdata-mdm.version}</version>
        </dependency>

        <!-- auth-->
        <dependency>
            <groupId>tech.qiantong</groupId>
            <artifactId>qdata-mdm-auth</artifactId>
            <version>${qdata-mdm.version}</version>
        </dependency>

        <!-- model-api模块 -->
        <dependency>
            <groupId>tech.qiantong</groupId>
            <artifactId>qdata-mdm-module-model-api</artifactId>
            <version>${qdata-mdm.version}</version>
        </dependency>

        <!-- 模型发布通过规则公共API读取关联配置，不依赖rule-biz或直接查询规则表。 -->
        <dependency>
            <groupId>tech.qiantong</groupId>
            <artifactId>qdata-mdm-module-rule-api</artifactId>
            <version>${qdata-mdm.version}</version>
        </dependency>

        <dependency>
            <groupId>tech.qiantong</groupId>
            <artifactId>qdata-mdm-module-master-api</artifactId>
            <version>${qdata-mdm.version}</version>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 固定JUnit4参数化测试运行器和报告格式，便于真实数据库矩阵重复验收。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-junit4</artifactId>
                        <version>3.2.5</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
</project>
