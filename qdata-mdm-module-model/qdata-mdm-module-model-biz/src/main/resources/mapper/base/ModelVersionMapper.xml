<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tech.qiantong.qdata.mdm.model.dal.mapper.base.ModelVersionMapper">

    <resultMap type="ModelVersionDO" id="ModelVersionResult">
        <result property="id"    column="ID"    />
        <result property="modelId"    column="MODEL_ID"    />
        <result property="baseVersionId"    column="BASE_VERSION_ID"    />
        <result property="versionNo"    column="VERSION_NO"    />
        <result property="description"    column="DESCRIPTION"    />
        <result property="changeData"    column="CHANGE_DATA"    />
        <result property="validFlag"    column="VALID_FLAG"    />
        <result property="delFlag"    column="DEL_FLAG"    />
        <result property="createBy"    column="CREATE_BY"    />
        <result property="creatorId"    column="CREATOR_ID"    />
        <result property="createTime"    column="CREATE_TIME"    />
        <result property="updateBy"    column="UPDATE_BY"    />
        <result property="updaterId"    column="UPDATER_ID"    />
        <result property="updateTime"    column="UPDATE_TIME"    />
        <result property="remark"    column="REMARK"    />
        <result property="status"    column="STATUS"    />
    </resultMap>

    <sql id="selectModelVersionVo">
        select ID, MODEL_ID, BASE_VERSION_ID, VERSION_NO, DESCRIPTION, CHANGE_DATA, VALID_FLAG, DEL_FLAG, CREATE_BY, CREATOR_ID, CREATE_TIME, UPDATE_BY, UPDATER_ID, UPDATE_TIME, REMARK, STATUS from MODEL_VERSION
    </sql>

    <select id="selectModelVersionList" parameterType="ModelVersionDO" resultMap="ModelVersionResult">
        <include refid="selectModelVersionVo"/>
        <where>
            <if test="modelId != null "> and MODEL_ID = #{modelId}</if>
            <if test="baseVersionId != null "> and BASE_VERSION_ID = #{baseVersionId}</if>
            <if test="versionNo != null  and versionNo != ''"> and VERSION_NO = #{versionNo}</if>
            <if test="description != null  and description != ''"> and DESCRIPTION = #{description}</if>
            <if test="changeData != null  and changeData != ''"> and CHANGE_DATA = #{changeData}</if>
            <if test="createTime != null "> and CREATE_TIME = #{createTime}</if>
            <if test="status != null "> and STATUS = #{status}</if>
        </where>
    </select>

    <select id="selectModelVersionById" parameterType="Long" resultMap="ModelVersionResult">
        <include refid="selectModelVersionVo"/>
        where ID = #{id}
    </select>

    <insert id="insertModelVersion" parameterType="ModelVersionDO">
        insert into MODEL_VERSION
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">ID,</if>
            <if test="modelId != null">MODEL_ID,</if>
            <if test="baseVersionId != null">BASE_VERSION_ID,</if>
            <if test="versionNo != null">VERSION_NO,</if>
            <if test="description != null">DESCRIPTION,</if>
            <if test="changeData != null">CHANGE_DATA,</if>
            <if test="validFlag != null">VALID_FLAG,</if>
            <if test="delFlag != null">DEL_FLAG,</if>
            <if test="createBy != null">CREATE_BY,</if>
            <if test="creatorId != null">CREATOR_ID,</if>
            <if test="createTime != null">CREATE_TIME,</if>
            <if test="updateBy != null">UPDATE_BY,</if>
            <if test="updaterId != null">UPDATER_ID,</if>
            <if test="updateTime != null">UPDATE_TIME,</if>
            <if test="remark != null">REMARK,</if>
            <if test="status != null">STATUS,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="modelId != null">#{modelId},</if>
            <if test="baseVersionId != null">#{baseVersionId},</if>
            <if test="versionNo != null">#{versionNo},</if>
            <if test="description != null">#{description},</if>
            <if test="changeData != null">#{changeData},</if>
            <if test="validFlag != null">#{validFlag},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="creatorId != null">#{creatorId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updaterId != null">#{updaterId},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="status != null">#{status},</if>
         </trim>
    </insert>

    <update id="updateModelVersion" parameterType="ModelVersionDO">
        update MODEL_VERSION
        <trim prefix="SET" suffixOverrides=",">
            <if test="modelId != null">MODEL_ID = #{modelId},</if>
            <if test="baseVersionId != null">BASE_VERSION_ID = #{baseVersionId},</if>
            <if test="versionNo != null">VERSION_NO = #{versionNo},</if>
            <if test="description != null">DESCRIPTION = #{description},</if>
            <if test="changeData != null">CHANGE_DATA = #{changeData},</if>
            <if test="validFlag != null">VALID_FLAG = #{validFlag},</if>
            <if test="delFlag != null">DEL_FLAG = #{delFlag},</if>
            <if test="createBy != null">CREATE_BY = #{createBy},</if>
            <if test="creatorId != null">CREATOR_ID = #{creatorId},</if>
            <if test="createTime != null">CREATE_TIME = #{createTime},</if>
            <if test="updateBy != null">UPDATE_BY = #{updateBy},</if>
            <if test="updaterId != null">UPDATER_ID = #{updaterId},</if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime},</if>
            <if test="remark != null">REMARK = #{remark},</if>
            <if test="status != null">STATUS = #{status},</if>
        </trim>
        where ID = #{id}
    </update>

    <delete id="deleteModelVersionById" parameterType="Long">
        delete from MODEL_VERSION where ID = #{id}
    </delete>

    <delete id="deleteModelVersionByIds" parameterType="String">
        delete from MODEL_VERSION where ID in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
