<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tech.qiantong.qdata.mdm.model.dal.mapper.base.ModelMaterializedColumnMapper">

    <!-- 不按启用状态删减列；停用列仍属于成功实例保存的真实物理结构。 -->
    <select id="selectPublishedColumns" resultMap="ModelMaterializedColumnResult">
        <include refid="selectModelMaterializedColumnVo"/>
        WHERE MATERIALIZED_TABLE_ID IN
        <foreach collection="tableIds" item="tableId" open="(" separator="," close=")">#{tableId}</foreach>
        ORDER BY MATERIALIZED_TABLE_ID, COLUMN_POSITION, ID
    </select>

    <resultMap id="ModelMaterializedColumnResult"
               type="tech.qiantong.qdata.mdm.model.dal.dataobject.base.ModelMaterializedColumnDO">
        <id property="id" column="ID"/>
        <result property="materializedTableId" column="MATERIALIZED_TABLE_ID"/>
        <result property="modelFieldId" column="MODEL_FIELD_ID"/>
        <result property="systemFieldKey" column="SYSTEM_FIELD_KEY"/>
        <result property="columnName" column="COLUMN_NAME"/>
        <result property="logicalType" column="LOGICAL_TYPE"/>
        <result property="physicalType" column="PHYSICAL_TYPE"/>
        <result property="characterLength" column="CHARACTER_LENGTH"/>
        <result property="lengthUnit" column="LENGTH_UNIT"/>
        <result property="numericPrecision" column="NUMERIC_PRECISION"/>
        <result property="numericScale" column="NUMERIC_SCALE"/>
        <result property="nullable" column="NULLABLE"/>
        <result property="defaultValue" column="DEFAULT_VALUE"/>
        <result property="primaryKeyFlag" column="PRIMARY_KEY_FLAG"/>
        <result property="identityFlag" column="IDENTITY_FLAG"/>
        <result property="columnPosition" column="COLUMN_POSITION"/>
        <result property="columnComment" column="COLUMN_COMMENT"/>
        <result property="systemFlag" column="SYSTEM_FLAG"/>
        <result property="enabledFlag" column="ENABLED_FLAG"/>
        <result property="validFlag" column="VALID_FLAG"/>
        <result property="delFlag" column="DEL_FLAG"/>
        <result property="creatorId" column="CREATOR_ID"/>
        <result property="createBy" column="CREATE_BY"/>
        <result property="createTime" column="CREATE_TIME"/>
        <result property="updaterId" column="UPDATER_ID"/>
        <result property="updateBy" column="UPDATE_BY"/>
        <result property="updateTime" column="UPDATE_TIME"/>
        <result property="remark" column="REMARK"/>
    </resultMap>

    <sql id="selectModelMaterializedColumnVo">
        SELECT ID,
               MATERIALIZED_TABLE_ID,
               MODEL_FIELD_ID,
               SYSTEM_FIELD_KEY,
               COLUMN_NAME,
               LOGICAL_TYPE,
               PHYSICAL_TYPE,
               CHARACTER_LENGTH,
               LENGTH_UNIT,
               NUMERIC_PRECISION,
               NUMERIC_SCALE,
               NULLABLE,
               DEFAULT_VALUE,
               PRIMARY_KEY_FLAG,
               IDENTITY_FLAG,
               COLUMN_POSITION,
               COLUMN_COMMENT,
               SYSTEM_FLAG,
               ENABLED_FLAG,
               VALID_FLAG,
               DEL_FLAG,
               CREATOR_ID,
               CREATE_BY,
               CREATE_TIME,
               UPDATER_ID,
               UPDATE_BY,
               UPDATE_TIME,
               REMARK
        FROM MODEL_MATERIALIZED_COLUMN
    </sql>

</mapper>
