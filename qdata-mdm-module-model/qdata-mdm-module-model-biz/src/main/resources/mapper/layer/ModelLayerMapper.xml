<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tech.qiantong.qdata.mdm.model.dal.mapper.layer.ModelLayerMapper">

    <select id="selectAvailableMainInstanceLayers" resultMap="ModelLayerResult">
        SELECT DISTINCT l.ID, l.NAME
        FROM MODEL_LAYER l
                 INNER JOIN MODEL_BASE b ON b.LAYER_ID = l.ID
                 INNER JOIN MODEL_INSTANCE i ON i.MODEL_ID = b.ID AND i.ID = b.PUBLISHED_INSTANCE_ID
                 INNER JOIN MODEL_MATERIALIZED_TABLE t ON t.INSTANCE_ID = i.ID AND t.MODEL_ID = b.ID
        WHERE l.PROJECT_ID = #{projectId}
          AND b.PROJECT_ID = #{projectId}
          AND b.TYPE IN ('NORMAL', 'CATEGORY')
          AND l.DEL_FLAG = '0'
          AND l.VALID_FLAG = '1'
          AND i.STATUS = 'SUCCEEDED'
          AND b.DEL_FLAG = '0'
          AND EXISTS (SELECT 1
                      FROM MODEL_VERSION v
                      WHERE v.ID = b.VERSION_ID
                        AND v.MODEL_ID = b.ID
                        AND v.DEL_FLAG = '0'
                        AND v.STATUS IN (1, 2))
          AND t.PARENT_ID = 0
          AND t.TABLE_ROLE = 'AUTHORITY'
          AND t.VALID_FLAG = '1'
          AND t.DEL_FLAG = '0'
          AND t.ENABLED_FLAG = '1'
        ORDER BY l.NAME, l.ID
    </select>

    <resultMap type="ModelLayerDO" id="ModelLayerResult">
        <result property="id" column="ID"/>
        <result property="projectId" column="PROJECT_ID"/>
        <result property="parentId" column="PARENT_ID"/>
        <result property="code" column="CODE"/>
        <result property="name" column="NAME"/>
        <result property="responsibleUserId" column="RESPONSIBLE_USER_ID"/>
        <result property="sortOrder" column="SORT_ORDER"/>
        <result property="description" column="DESCRIPTION"/>
        <result property="validFlag" column="VALID_FLAG"/>
        <result property="delFlag" column="DEL_FLAG"/>
        <result property="createBy" column="CREATE_BY"/>
        <result property="creatorId" column="CREATOR_ID"/>
        <result property="createTime" column="CREATE_TIME"/>
        <result property="updateBy" column="UPDATE_BY"/>
        <result property="updaterId" column="UPDATER_ID"/>
        <result property="updateTime" column="UPDATE_TIME"/>
    </resultMap>

    <sql id="selectModelLayerVo">
        select ID,
               PROJECT_ID,
               PARENT_ID,
               CODE,
               NAME, RESPONSIBLE_USER_ID,
               SORT_ORDER,
               DESCRIPTION,
               VALID_FLAG,
               DEL_FLAG,
               CREATE_BY,
               CREATOR_ID,
               CREATE_TIME,
               UPDATE_BY,
               UPDATER_ID,
               UPDATE_TIME
        from MODEL_LAYER
    </sql>

    <select id="selectModelLayerList" parameterType="ModelLayerDO" resultMap="ModelLayerResult">
        <include refid="selectModelLayerVo"/>
        <where>
            <if test="projectId != null ">and PROJECT_ID = #{projectId}</if>
            <if test="parentId != null ">and PARENT_ID = #{parentId}</if>
            <if test="code != null  and code != ''">and CODE = #{code}</if>
            <if test="responsibleUserId != null"> and RESPONSIBLE_USER_ID = #{responsibleUserId}</if>
            <if test="name != null  and name != ''">and NAME like concat(concat('%', #{name}), '%')</if>
            <if test="sortOrder != null ">and SORT_ORDER = #{sortOrder}</if>
            <if test="description != null  and description != ''">and DESCRIPTION = #{description}</if>
            <if test="createTime != null ">and CREATE_TIME = #{createTime}</if>
        </where>
    </select>

    <select id="selectModelLayerById" parameterType="Long" resultMap="ModelLayerResult">
        <include refid="selectModelLayerVo"/>
        where ID = #{id}
    </select>

    <insert id="insertModelLayer" parameterType="ModelLayerDO">
        insert into MODEL_LAYER
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">ID,</if>
            <if test="projectId != null">PROJECT_ID,</if>
            <if test="parentId != null">PARENT_ID,</if>
            <if test="code != null">CODE,</if>
            <if test="name != null">NAME,</if>
            <if test="responsibleUserId != null">RESPONSIBLE_USER_ID,</if>
            <if test="sortOrder != null">SORT_ORDER,</if>
            <if test="description != null">DESCRIPTION,</if>
            <if test="validFlag != null">VALID_FLAG,</if>
            <if test="delFlag != null">DEL_FLAG,</if>
            <if test="createBy != null">CREATE_BY,</if>
            <if test="creatorId != null">CREATOR_ID,</if>
            <if test="createTime != null">CREATE_TIME,</if>
            <if test="updateBy != null">UPDATE_BY,</if>
            <if test="updaterId != null">UPDATER_ID,</if>
            <if test="updateTime != null">UPDATE_TIME,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="projectId != null">#{projectId},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="code != null">#{code},</if>
            <if test="name != null">#{name},</if>
            <if test="responsibleUserId != null">#{responsibleUserId},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            <if test="description != null">#{description},</if>
            <if test="validFlag != null">#{validFlag},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="creatorId != null">#{creatorId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updaterId != null">#{updaterId},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateModelLayer" parameterType="ModelLayerDO">
        update MODEL_LAYER
        <trim prefix="SET" suffixOverrides=",">
            <if test="projectId != null">PROJECT_ID = #{projectId},</if>
            <if test="parentId != null">PARENT_ID = #{parentId},</if>
            <if test="code != null">CODE = #{code},</if>
            <if test="name != null">NAME = #{name},</if>
            RESPONSIBLE_USER_ID = #{responsibleUserId,jdbcType=BIGINT},
            <if test="sortOrder != null">SORT_ORDER = #{sortOrder},</if>
            <if test="description != null">DESCRIPTION = #{description},</if>
            <if test="validFlag != null">VALID_FLAG = #{validFlag},</if>
            <if test="delFlag != null">DEL_FLAG = #{delFlag},</if>
            <if test="createBy != null">CREATE_BY = #{createBy},</if>
            <if test="creatorId != null">CREATOR_ID = #{creatorId},</if>
            <if test="createTime != null">CREATE_TIME = #{createTime},</if>
            <if test="updateBy != null">UPDATE_BY = #{updateBy},</if>
            <if test="updaterId != null">UPDATER_ID = #{updaterId},</if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime},</if>
        </trim>
        where ID = #{id}
    </update>

    <delete id="deleteModelLayerById" parameterType="Long">
        delete
        from MODEL_LAYER
        where ID = #{id}
    </delete>

    <delete id="deleteModelLayerByIds" parameterType="String">
        delete from MODEL_LAYER where ID in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
