<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tech.qiantong.qdata.mdm.model.dal.mapper.encoding.ModelEncodingVersionMapper">

    <resultMap type="ModelEncodingVersionDO" id="ModelEncodingVersionResult">
        <result property="id"    column="ID"    />
        <result property="encodingId"    column="ENCODING_ID"    />
        <result property="versionNo"    column="VERSION_NO"    />
        <result property="status"    column="STATUS"    />
        <result property="effectiveTime"    column="EFFECTIVE_TIME"    />
        <result property="createBy"    column="CREATE_BY"    />
        <result property="createTime"    column="CREATE_TIME"    />
        <result property="updateBy"    column="UPDATE_BY"    />
        <result property="updateTime"    column="UPDATE_TIME"    />
        <result property="delFlag"    column="DEL_FLAG"    />
        <result property="remark"    column="REMARK"    />
        <result property="creatorId"    column="CREATOR_ID"    />
        <result property="updaterId"    column="UPDATER_ID"    />
        <result property="validFlag"    column="VALID_FLAG"    />
    </resultMap>

    <sql id="selectModelEncodingVersionVo">
        select ID, ENCODING_ID, VERSION_NO, STATUS, EFFECTIVE_TIME, CREATE_BY, CREATE_TIME, UPDATE_BY, UPDATE_TIME, DEL_FLAG, REMARK, CREATOR_ID, UPDATER_ID, VALID_FLAG from MODEL_ENCODING_VERSION
    </sql>

    <!-- 唯一约束包含已逻辑删除的版本，取号时不能附加 DEL_FLAG 过滤。 -->
    <select id="selectHistoryIncludingDeleted" resultMap="ModelEncodingVersionResult">
        <include refid="selectModelEncodingVersionVo"/>
        where ENCODING_ID = #{encodingId}
    </select>

    <select id="selectModelEncodingVersionList" parameterType="ModelEncodingVersionDO" resultMap="ModelEncodingVersionResult">
        <include refid="selectModelEncodingVersionVo"/>
        <where>
            <if test="encodingId != null "> and ENCODING_ID = #{encodingId}</if>
            <if test="versionNo != null  and versionNo != ''"> and VERSION_NO = #{versionNo}</if>
            <if test="status != null  and status != ''"> and STATUS = #{status}</if>
            <if test="effectiveTime != null "> and EFFECTIVE_TIME = #{effectiveTime}</if>
            <if test="createTime != null "> and CREATE_TIME = #{createTime}</if>
        </where>
    </select>

    <select id="selectModelEncodingVersionById" parameterType="Long" resultMap="ModelEncodingVersionResult">
        <include refid="selectModelEncodingVersionVo"/>
        where ID = #{id}
    </select>

    <insert id="insertModelEncodingVersion" parameterType="ModelEncodingVersionDO">
        insert into MODEL_ENCODING_VERSION
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">ID,</if>
            <if test="encodingId != null">ENCODING_ID,</if>
            <if test="versionNo != null and versionNo != ''">VERSION_NO,</if>
            <if test="status != null">STATUS,</if>
            <if test="effectiveTime != null">EFFECTIVE_TIME,</if>
            <if test="createBy != null">CREATE_BY,</if>
            <if test="createTime != null">CREATE_TIME,</if>
            <if test="updateBy != null">UPDATE_BY,</if>
            <if test="updateTime != null">UPDATE_TIME,</if>
            <if test="delFlag != null">DEL_FLAG,</if>
            <if test="remark != null">REMARK,</if>
            <if test="creatorId != null">CREATOR_ID,</if>
            <if test="updaterId != null">UPDATER_ID,</if>
            <if test="validFlag != null">VALID_FLAG,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="encodingId != null">#{encodingId},</if>
            <if test="versionNo != null and versionNo != ''">#{versionNo},</if>
            <if test="status != null">#{status},</if>
            <if test="effectiveTime != null">#{effectiveTime},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="remark != null">#{remark},</if>
            <if test="creatorId != null">#{creatorId},</if>
            <if test="updaterId != null">#{updaterId},</if>
            <if test="validFlag != null">#{validFlag},</if>
         </trim>
    </insert>

    <update id="updateModelEncodingVersion" parameterType="ModelEncodingVersionDO">
        update MODEL_ENCODING_VERSION
        <trim prefix="SET" suffixOverrides=",">
            <if test="encodingId != null">ENCODING_ID = #{encodingId},</if>
            <if test="versionNo != null and versionNo != ''">VERSION_NO = #{versionNo},</if>
            <if test="status != null">STATUS = #{status},</if>
            <if test="effectiveTime != null">EFFECTIVE_TIME = #{effectiveTime},</if>
            <if test="createBy != null">CREATE_BY = #{createBy},</if>
            <if test="createTime != null">CREATE_TIME = #{createTime},</if>
            <if test="updateBy != null">UPDATE_BY = #{updateBy},</if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime},</if>
            <if test="delFlag != null">DEL_FLAG = #{delFlag},</if>
            <if test="remark != null">REMARK = #{remark},</if>
            <if test="creatorId != null">CREATOR_ID = #{creatorId},</if>
            <if test="updaterId != null">UPDATER_ID = #{updaterId},</if>
            <if test="validFlag != null">VALID_FLAG = #{validFlag},</if>
        </trim>
        where ID = #{id}
    </update>

    <delete id="deleteModelEncodingVersionById" parameterType="Long">
        delete from MODEL_ENCODING_VERSION where ID = #{id}
    </delete>

    <delete id="deleteModelEncodingVersionByIds" parameterType="String">
        delete from MODEL_ENCODING_VERSION where ID in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
