<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tech.qiantong.qdata.mdm.rule.dal.mapper.ruleMatch.RuleMatchMapper">

    <!-- 规则归属由规则模块维护；模型发布保存完整状态，不套用管理列表的有效/删除过滤。 -->
    <select id="selectModelRules" resultMap="RuleMatchResult">
        <include refid="selectRuleMatchVo"/>
        WHERE MODEL_ID IN
        <foreach collection="modelIds" item="modelId" open="(" separator="," close=")">#{modelId}</foreach>
        ORDER BY ID
    </select>



    <select id="selectDisplayInfo" resultMap="RuleMatchResult">
        SELECT r.ID,
               COALESCE(NULLIF(u.nick_name, ''), u.user_name) AS RESPONSIBLE_USER_NAME,
               u.phonenumber AS RESPONSIBLE_USER_PHONE,
               p.NAME AS PROJECT_NAME, l.NAME AS LAYER_NAME,
               (SELECT COUNT(*) FROM MERGE_DUPLICATE_TASK t
                WHERE t.MODEL_ID = r.MODEL_ID AND t.DEL_FLAG = '0') AS DUPLICATE_TASK_COUNT
        FROM RULE_MATCH r
        LEFT JOIN system_user u ON u.user_id = r.RESPONSIBLE_USER_ID AND u.del_flag = '0'
        LEFT JOIN MODEL_BASE m ON m.ID = r.MODEL_ID AND m.DEL_FLAG = '0'
        LEFT JOIN MODEL_PROJECT p ON p.ID = m.PROJECT_ID AND p.DEL_FLAG = '0'
        LEFT JOIN MODEL_LAYER l ON l.ID = m.LAYER_ID AND l.DEL_FLAG = '0'
        WHERE r.ID IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>

    <resultMap type="RuleMatchDO" id="RuleMatchResult">
        <result property="responsibleUserName" column="RESPONSIBLE_USER_NAME" />
        <result property="responsibleUserPhone" column="RESPONSIBLE_USER_PHONE" />
        <result property="projectName" column="PROJECT_NAME" />
        <result property="layerName" column="LAYER_NAME" />
        <result property="duplicateTaskCount" column="DUPLICATE_TASK_COUNT" />
        <result property="id"    column="ID"    />
        <result property="responsibleUserId" column="RESPONSIBLE_USER_ID" />
        <result property="ruleCode"    column="RULE_CODE"    />
        <result property="ruleName"    column="RULE_NAME"    />
        <result property="modelId"    column="MODEL_ID"    />
        <result property="modelVersion"    column="MODEL_VERSION"    />
        <result property="priority"    column="PRIORITY"    />
        <result property="validFlag"    column="VALID_FLAG"    />
        <result property="abnormalFlag"    column="ABNORMAL_FLAG"    />
        <result property="modelFieldId"    column="MODEL_FIELD_ID"    />
        <result property="ruleType"    column="RULE_TYPE"    />
        <result property="ruleConfig"    column="RULE_CONFIG"    />
        <result property="ruleScore"    column="RULE_SCORE"    />
        <result property="description"    column="DESCRIPTION"    />
        <result property="delFlag"    column="DEL_FLAG"    />
        <result property="createBy"    column="CREATE_BY"    />
        <result property="creatorId"    column="CREATOR_ID"    />
        <result property="createTime"    column="CREATE_TIME"    />
        <result property="updateBy"    column="UPDATE_BY"    />
        <result property="updaterId"    column="UPDATER_ID"    />
        <result property="updateTime"    column="UPDATE_TIME"    />
        <result property="remark"    column="REMARK"    />
    </resultMap>

    <sql id="selectRuleMatchVo">
        select ID, RESPONSIBLE_USER_ID, RULE_CODE, RULE_NAME, MODEL_ID, MODEL_VERSION, PRIORITY, VALID_FLAG, ABNORMAL_FLAG, MODEL_FIELD_ID, RULE_TYPE, RULE_CONFIG, RULE_SCORE, DESCRIPTION, DEL_FLAG, CREATE_BY, CREATOR_ID, CREATE_TIME, UPDATE_BY, UPDATER_ID, UPDATE_TIME, REMARK from RULE_MATCH
    </sql>

    <select id="selectRuleMatchList" parameterType="RuleMatchDO" resultMap="RuleMatchResult">
        <include refid="selectRuleMatchVo"/>
        <where>
            <if test="ruleCode != null  and ruleCode != ''"> and RULE_CODE = #{ruleCode}</if>
            <if test="ruleName != null  and ruleName != ''"> and RULE_NAME like concat(concat('%', #{ruleName}), '%')</if>
            <if test="modelId != null "> and MODEL_ID = #{modelId}</if>
            <if test="modelVersion != null  and modelVersion != ''"> and MODEL_VERSION = #{modelVersion}</if>
            <if test="priority != null "> and PRIORITY = #{priority}</if>
            <if test="validFlag != null "> and VALID_FLAG = #{validFlag}</if>
            <if test="abnormalFlag != null  and abnormalFlag != ''"> and ABNORMAL_FLAG = #{abnormalFlag}</if>
            <if test="modelFieldId != null  and modelFieldId != ''"> and MODEL_FIELD_ID = #{modelFieldId}</if>
            <if test="ruleType != null  and ruleType != ''"> and RULE_TYPE = #{ruleType}</if>
            <if test="ruleConfig != null  and ruleConfig != ''"> and RULE_CONFIG = #{ruleConfig}</if>
            <if test="ruleScore != null "> and RULE_SCORE = #{ruleScore}</if>
            <if test="description != null  and description != ''"> and DESCRIPTION = #{description}</if>
            <if test="createBy != null  and createBy != ''"> and CREATE_BY = #{createBy}</if>
            <if test="createTime != null "> and CREATE_TIME = #{createTime}</if>
            <if test="updateBy != null  and updateBy != ''"> and UPDATE_BY = #{updateBy}</if>
            <if test="updateTime != null "> and UPDATE_TIME = #{updateTime}</if>
        </where>
    </select>

    <select id="selectRuleMatchById" parameterType="Long" resultMap="RuleMatchResult">
        <include refid="selectRuleMatchVo"/>
        where ID = #{id}
    </select>

    <insert id="insertRuleMatch" parameterType="RuleMatchDO">
        insert into RULE_MATCH
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">ID,</if>
            <if test="responsibleUserId != null">RESPONSIBLE_USER_ID,</if>
            <if test="ruleCode != null">RULE_CODE,</if>
            <if test="ruleName != null">RULE_NAME,</if>
            <if test="modelId != null">MODEL_ID,</if>
            <if test="modelVersion != null">MODEL_VERSION,</if>
            <if test="priority != null">PRIORITY,</if>
            <if test="validFlag != null">VALID_FLAG,</if>
            <if test="abnormalFlag != null">ABNORMAL_FLAG,</if>
            <if test="modelFieldId != null">MODEL_FIELD_ID,</if>
            <if test="ruleType != null">RULE_TYPE,</if>
            <if test="ruleConfig != null">RULE_CONFIG,</if>
            <if test="ruleScore != null">RULE_SCORE,</if>
            <if test="description != null">DESCRIPTION,</if>
            <if test="delFlag != null">DEL_FLAG,</if>
            <if test="createBy != null">CREATE_BY,</if>
            <if test="creatorId != null">CREATOR_ID,</if>
            <if test="createTime != null">CREATE_TIME,</if>
            <if test="updateBy != null">UPDATE_BY,</if>
            <if test="updaterId != null">UPDATER_ID,</if>
            <if test="updateTime != null">UPDATE_TIME,</if>
            <if test="remark != null">REMARK,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="responsibleUserId != null">#{responsibleUserId},</if>
            <if test="ruleCode != null">#{ruleCode},</if>
            <if test="ruleName != null">#{ruleName},</if>
            <if test="modelId != null">#{modelId},</if>
            <if test="modelVersion != null">#{modelVersion},</if>
            <if test="priority != null">#{priority},</if>
            <if test="validFlag != null">#{validFlag},</if>
            <if test="abnormalFlag != null">#{abnormalFlag},</if>
            <if test="modelFieldId != null">#{modelFieldId},</if>
            <if test="ruleType != null">#{ruleType},</if>
            <if test="ruleConfig != null">#{ruleConfig},</if>
            <if test="ruleScore != null">#{ruleScore},</if>
            <if test="description != null">#{description},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="creatorId != null">#{creatorId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updaterId != null">#{updaterId},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateRuleMatch" parameterType="RuleMatchDO">
        update RULE_MATCH
        <trim prefix="SET" suffixOverrides=",">
            <if test="responsibleUserId != null">RESPONSIBLE_USER_ID = #{responsibleUserId},</if>
            <if test="ruleCode != null">RULE_CODE = #{ruleCode},</if>
            <if test="ruleName != null">RULE_NAME = #{ruleName},</if>
            <if test="modelId != null">MODEL_ID = #{modelId},</if>
            <if test="modelVersion != null">MODEL_VERSION = #{modelVersion},</if>
            <if test="priority != null">PRIORITY = #{priority},</if>
            <if test="validFlag != null">VALID_FLAG = #{validFlag},</if>
            <if test="abnormalFlag != null">ABNORMAL_FLAG = #{abnormalFlag},</if>
            <if test="modelFieldId != null">MODEL_FIELD_ID = #{modelFieldId},</if>
            <if test="ruleType != null">RULE_TYPE = #{ruleType},</if>
            <if test="ruleConfig != null">RULE_CONFIG = #{ruleConfig},</if>
            <if test="ruleScore != null">RULE_SCORE = #{ruleScore},</if>
            <if test="description != null">DESCRIPTION = #{description},</if>
            <if test="delFlag != null">DEL_FLAG = #{delFlag},</if>
            <if test="createBy != null">CREATE_BY = #{createBy},</if>
            <if test="creatorId != null">CREATOR_ID = #{creatorId},</if>
            <if test="createTime != null">CREATE_TIME = #{createTime},</if>
            <if test="updateBy != null">UPDATE_BY = #{updateBy},</if>
            <if test="updaterId != null">UPDATER_ID = #{updaterId},</if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime},</if>
            <if test="remark != null">REMARK = #{remark},</if>
        </trim>
        where ID = #{id}
    </update>

    <delete id="deleteRuleMatchById" parameterType="Long">
        delete from RULE_MATCH where ID = #{id}
    </delete>

    <delete id="deleteRuleMatchByIds" parameterType="String">
        delete from RULE_MATCH where ID in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
