    <!-- 批量补充责任人姓名及电话，供任务基本信息展示，避免按任务逐条查询用户。 -->
    <select id="selectListDetails" resultMap="DistTaskListDetailsResult">
        SELECT t.ID AS TASK_ID,
               CASE WHEN t.MODEL_ID = -1 THEN '供应商主数据' ELSE m.NAME END AS MODEL_NAME,
               p.NAME AS PROJECT_NAME,
               p.ICON AS PROJECT_ICON,
               l.NAME AS LAYER_NAME,
               s.CODE AS TARGET_SYSTEM_CODE,
               s.NAME AS TARGET_SYSTEM_NAME,
               COALESCE(owner.NICK_NAME, owner.USER_NAME) AS RESPONSIBLE_USER_NAME,
               owner.PHONENUMBER AS RESPONSIBLE_PHONE,
               u.PHONENUMBER AS CREATOR_PHONE,
               i.START_TIME AS LAST_RUN_TIME,
               i.END_TIME AS LAST_RUN_END_TIME,
               i.RUN_STATUS AS LAST_RUN_STATUS,
               i.SUCCESS_COUNT AS LAST_SUCCESS_COUNT,
               i.FAILURE_COUNT AS LAST_FAILURE_COUNT
        FROM DIST_TASK t
        LEFT JOIN MODEL_BASE m ON m.ID = t.MODEL_ID
        LEFT JOIN MODEL_PROJECT p ON p.ID = m.PROJECT_ID
        LEFT JOIN MODEL_LAYER l ON l.ID = m.LAYER_ID AND l.PROJECT_ID = m.PROJECT_ID
        LEFT JOIN DIST_TARGET_SYSTEM s ON s.ID = t.TARGET_SYSTEM_ID
        LEFT JOIN SYSTEM_USER owner ON owner.USER_ID = t.RESP_USER_ID AND owner.DEL_FLAG = '0'
        LEFT JOIN SYSTEM_USER u ON u.USER_ID = t.CREATOR_ID
        LEFT JOIN (
            SELECT TASK_ID, MAX(ID) AS LATEST_ID
            FROM DIST_TASK_INSTANCE
            WHERE TASK_ID IN
            <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
            GROUP BY TASK_ID
        ) latest ON latest.TASK_ID = t.ID
        LEFT JOIN DIST_TASK_INSTANCE i ON i.ID = latest.LATEST_ID
        WHERE t.ID IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>

    <sql id="selectDistTaskVo">
        select ID, CODE, NAME, MODEL_ID, MODEL_VERSION_ID, TARGET_SYSTEM_ID, RESP_USER_ID, TYPE, DATA_MODE, TRIGGER_TYPE, RETRY_TRIGGER_TYPE, FAIL_RETRY_FLAG, FAIL_RETRY_TIMES, FAIL_RETRY_INTERVAL, FAIL_RETRY_OUT_TYPE, CRON_EXPRESSION, INCREMENTAL_START_TIME, DATA_SCOPE_TYPE, API_URL, HTTP_METHOD, AUTH_TYPE, AUTH_CONFIG, HEADER_CONFIG, REQUEST_BODY_MODE, SUCCESS_CONDITION, STATUS, LAST_SUCCESS_TIME, VALID_FLAG, DEL_FLAG, CREATE_BY, CREATOR_ID, CREATE_TIME, UPDATE_BY, UPDATER_ID, UPDATE_TIME, REMARK from DIST_TASK
    </sql>

    <select id="selectDistTaskList" parameterType="DistTaskDO" resultMap="DistTaskResult">
