<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tech.qiantong.qdata.mdm.dist.dal.mapper.service.DistServiceMapper">
    <resultMap id="CreatorPhoneResult" type="tech.qiantong.qdata.mdm.dist.controller.admin.service.vo.DistServiceRespVO">
        <id property="creatorId" column="USER_ID" />
        <result property="creatorPhone" column="PHONENUMBER" />
    </resultMap>

    <!-- 按当前页创建人批量读取电话，与来源系统的用户展示查询保持一致。 -->
    <select id="selectCreatorPhonesByIds" resultMap="CreatorPhoneResult">
        SELECT USER_ID, PHONENUMBER
        FROM SYSTEM_USER
        WHERE DEL_FLAG = '0'
          AND USER_ID IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
</mapper>
