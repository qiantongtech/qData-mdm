<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="tech.qiantong.qdata.mdm.quality.dal.mapper.qualityTask.QualityTaskMapper">

    <resultMap type="QualityTaskDO" id="QualityTaskResult">
        <result property="id"    column="ID"    />
        <result property="taskCode"    column="TASK_CODE"    />
        <result property="taskName"    column="TASK_NAME"    />
        <result property="responsibleUserId" column="RESPONSIBLE_USER_ID" />
        <result property="modelId"    column="MODEL_ID"    />
        <result property="modelVersion"    column="MODEL_VERSION"    />
        <result property="dataScopeType"    column="DATA_SCOPE_TYPE"    />
        <result property="dataScopeConfig"    column="DATA_SCOPE_CONFIG"    />
        <result property="scheduleFlag"    column="SCHEDULE_FLAG"    />
        <result property="scheduleConfig"    column="SCHEDULE_CONFIG"    />
        <result property="status"    column="STATUS"    />
        <result property="lastRunTime"    column="LAST_RUN_TIME"    />
        <result property="lastRunStatus"    column="LAST_RUN_STATUS"    />
        <result property="lastResult"    column="LAST_RESULT"    />
        <result property="validFlag"    column="VALID_FLAG"    />
        <result property="delFlag"    column="DEL_FLAG"    />
        <result property="createBy"    column="CREATE_BY"    />
        <result property="creatorId"    column="CREATOR_ID"    />
        <result property="createTime"    column="CREATE_TIME"    />
        <result property="updateBy"    column="UPDATE_BY"    />
        <result property="updaterId"    column="UPDATER_ID"    />
        <result property="updateTime"    column="UPDATE_TIME"    />
        <result property="remark"    column="REMARK"    />
    </resultMap>

    <sql id="selectQualityTaskVo">
        select ID, TASK_CODE, TASK_NAME, RESPONSIBLE_USER_ID, MODEL_ID, MODEL_VERSION, DATA_SCOPE_TYPE, DATA_SCOPE_CONFIG, SCHEDULE_FLAG, SCHEDULE_CONFIG, STATUS, LAST_RUN_TIME, LAST_RUN_STATUS, LAST_RESULT, VALID_FLAG, DEL_FLAG, CREATE_BY, CREATOR_ID, CREATE_TIME, UPDATE_BY, UPDATER_ID, UPDATE_TIME, REMARK from QUALITY_TASK
    </sql>

    <select id="selectQualityTaskList" parameterType="QualityTaskDO" resultMap="QualityTaskResult">
        <include refid="selectQualityTaskVo"/>
        <where>
            <if test="taskCode != null  and taskCode != ''"> and TASK_CODE = #{taskCode}</if>
            <if test="taskName != null  and taskName != ''"> and TASK_NAME like concat(concat('%', #{taskName}), '%')</if>
            <if test="responsibleUserId != null"> and RESPONSIBLE_USER_ID = #{responsibleUserId}</if>
            <if test="modelId != null "> and MODEL_ID = #{modelId}</if>
            <if test="modelVersion != null  and modelVersion != ''"> and MODEL_VERSION = #{modelVersion}</if>
            <if test="dataScopeType != null  and dataScopeType != ''"> and DATA_SCOPE_TYPE = #{dataScopeType}</if>
            <if test="dataScopeConfig != null  and dataScopeConfig != ''"> and DATA_SCOPE_CONFIG = #{dataScopeConfig}</if>
            <if test="scheduleFlag != null  and scheduleFlag != ''"> and SCHEDULE_FLAG = #{scheduleFlag}</if>
            <if test="scheduleConfig != null  and scheduleConfig != ''"> and SCHEDULE_CONFIG = #{scheduleConfig}</if>
            <if test="status != null  and status != ''"> and STATUS = #{status}</if>
            <if test="lastRunTime != null "> and LAST_RUN_TIME = #{lastRunTime}</if>
            <if test="lastRunStatus != null  and lastRunStatus != ''"> and LAST_RUN_STATUS = #{lastRunStatus}</if>
            <if test="validFlag != null "> and VALID_FLAG = #{validFlag}</if>
            <if test="createTime != null "> and CREATE_TIME = #{createTime}</if>
            <if test="updateTime != null "> and UPDATE_TIME = #{updateTime}</if>
        </where>
    </select>

    <select id="selectQualityTaskById" parameterType="Long" resultMap="QualityTaskResult">
        <include refid="selectQualityTaskVo"/>
        where ID = #{id}
    </select>

    <insert id="insertQualityTask" parameterType="QualityTaskDO">
        insert into QUALITY_TASK
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">ID,</if>
            <if test="taskCode != null">TASK_CODE,</if>
            <if test="taskName != null">TASK_NAME,</if>
            <if test="responsibleUserId != null">RESPONSIBLE_USER_ID,</if>
            <if test="modelId != null">MODEL_ID,</if>
            <if test="modelVersion != null">MODEL_VERSION,</if>
            <if test="dataScopeType != null">DATA_SCOPE_TYPE,</if>
            <if test="dataScopeConfig != null">DATA_SCOPE_CONFIG,</if>
            <if test="scheduleFlag != null">SCHEDULE_FLAG,</if>
            <if test="scheduleConfig != null">SCHEDULE_CONFIG,</if>
            <if test="status != null">STATUS,</if>
            <if test="lastRunTime != null">LAST_RUN_TIME,</if>
            <if test="lastRunStatus != null">LAST_RUN_STATUS,</if>
            <if test="lastResult != null">LAST_RESULT,</if>
            <if test="validFlag != null">VALID_FLAG,</if>
            <if test="delFlag != null">DEL_FLAG,</if>
            <if test="createBy != null">CREATE_BY,</if>
            <if test="creatorId != null">CREATOR_ID,</if>
            <if test="createTime != null">CREATE_TIME,</if>
            <if test="updateBy != null">UPDATE_BY,</if>
            <if test="updaterId != null">UPDATER_ID,</if>
            <if test="updateTime != null">UPDATE_TIME,</if>
            <if test="remark != null">REMARK,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="taskCode != null">#{taskCode},</if>
            <if test="taskName != null">#{taskName},</if>
            <if test="responsibleUserId != null">#{responsibleUserId},</if>
            <if test="modelId != null">#{modelId},</if>
            <if test="modelVersion != null">#{modelVersion},</if>
            <if test="dataScopeType != null">#{dataScopeType},</if>
            <if test="dataScopeConfig != null">#{dataScopeConfig},</if>
            <if test="scheduleFlag != null">#{scheduleFlag},</if>
            <if test="scheduleConfig != null">#{scheduleConfig},</if>
            <if test="status != null">#{status},</if>
            <if test="lastRunTime != null">#{lastRunTime},</if>
            <if test="lastRunStatus != null">#{lastRunStatus},</if>
            <if test="lastResult != null">#{lastResult},</if>
            <if test="validFlag != null">#{validFlag},</if>
            <if test="delFlag != null">#{delFlag},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="creatorId != null">#{creatorId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updaterId != null">#{updaterId},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateQualityTask" parameterType="QualityTaskDO">
        update QUALITY_TASK
        <trim prefix="SET" suffixOverrides=",">
            <if test="taskCode != null">TASK_CODE = #{taskCode},</if>
            <if test="taskName != null">TASK_NAME = #{taskName},</if>
            <if test="responsibleUserId != null">RESPONSIBLE_USER_ID = #{responsibleUserId},</if>
            <if test="modelId != null">MODEL_ID = #{modelId},</if>
            <if test="modelVersion != null">MODEL_VERSION = #{modelVersion},</if>
            <if test="dataScopeType != null">DATA_SCOPE_TYPE = #{dataScopeType},</if>
            <if test="dataScopeConfig != null">DATA_SCOPE_CONFIG = #{dataScopeConfig},</if>
            <if test="scheduleFlag != null">SCHEDULE_FLAG = #{scheduleFlag},</if>
            <if test="scheduleConfig != null">SCHEDULE_CONFIG = #{scheduleConfig},</if>
            <if test="status != null">STATUS = #{status},</if>
            <if test="lastRunTime != null">LAST_RUN_TIME = #{lastRunTime},</if>
            <if test="lastRunStatus != null">LAST_RUN_STATUS = #{lastRunStatus},</if>
            <if test="lastResult != null">LAST_RESULT = #{lastResult},</if>
            <if test="validFlag != null">VALID_FLAG = #{validFlag},</if>
            <if test="delFlag != null">DEL_FLAG = #{delFlag},</if>
            <if test="createBy != null">CREATE_BY = #{createBy},</if>
            <if test="creatorId != null">CREATOR_ID = #{creatorId},</if>
            <if test="createTime != null">CREATE_TIME = #{createTime},</if>
            <if test="updateBy != null">UPDATE_BY = #{updateBy},</if>
            <if test="updaterId != null">UPDATER_ID = #{updaterId},</if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime},</if>
            <if test="remark != null">REMARK = #{remark},</if>
        </trim>
        where ID = #{id}
    </update>

    <delete id="deleteQualityTaskById" parameterType="Long">
        delete from QUALITY_TASK where ID = #{id}
    </delete>

    <delete id="deleteQualityTaskByIds" parameterType="String">
        delete from QUALITY_TASK where ID in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
